---
import Base from '../../layouts/Base.astro';
import { businesses } from '../../data/listings';
export function getStaticPaths() { return businesses.filter(item => item.citySlug === 'round-rock').map(item => ({params: {slug:item.slug}})); }
const path = `/business/${Astro.params.slug}`;
---
<Base page="business" path={path} />
